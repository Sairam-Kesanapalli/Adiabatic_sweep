* ============================================================
* ECRL ENERGY vs TRANSITION FREQUENCY
*
* X-axis : Transition Frequency (MHz)
* Y-axis : Energy per operation (pJ)
*
* f_transition = 1 / Tphase
*
* Display range:
*   X = 0 to 100 MHz
*   Y = 0 to 0.03 pJ
* ============================================================

.control

set noaskquit

* ============================================================
* TRANSITION FREQUENCY
* ============================================================

let FTR = vector(7)

let FTR[0] = 10
let FTR[1] = 20
let FTR[2] = 50
let FTR[3] = 100
let FTR[4] = 200
let FTR[5] = 500
let FTR[6] = 1000


* ============================================================
* W = 0.84 um
* Values converted from fJ to pJ
* ============================================================

let E084 = vector(7)

let E084[0] = 0.00545023
let E084[1] = 0.00610257
let E084[2] = 0.0103207
let E084[3] = 0.0185206
let E084[4] = 0.0290713
let E084[5] = 0.0463956
let E084[6] = 0.0631894


