* ============================================================
* ECRL INVERTER
* Energy per operation vs Power-Clock Frequency
*
* Data obtained from the completed SKY130 ECRL simulations
*
* X-axis : Power-clock frequency (MHz)
* Y-axis : Energy per operation (fJ)
*
* f_clock = 1 / (4*Tphase)
* ============================================================

.control

* ------------------------------------------------------------
* POWER-CLOCK FREQUENCY
* Corresponding Tphase values:
*
* Tphase = 100, 50, 20, 10, 5, 2, 1 ns
*
* f = 1/(4*Tphase)
*
* Therefore:
* 2.5, 5, 12.5, 25, 50, 125, 250 MHz
* ------------------------------------------------------------

let FREQ = vector(7)

let FREQ[0] = 2.5
let FREQ[1] = 5
let FREQ[2] = 12.5
let FREQ[3] = 25
let FREQ[4] = 50
let FREQ[5] = 125
let FREQ[6] = 250


* ============================================================
* W = 0.84 um
* ============================================================

let E084 = vector(7)

let E084[0] = 5.45023
let E084[1] = 6.10257
let E084[2] = 10.3207
let E084[3] = 18.5206
let E084[4] = 29.0713
let E084[5] = 46.3956
let E084[6] = 63.1894


